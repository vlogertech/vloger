{
  "name": "Comment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_username": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "voice"
      ],
      "default": "text"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "parent_id": {
      "type": "string"
    }
  },
  "required": [
    "post_id",
    "author_id"
  ]
}